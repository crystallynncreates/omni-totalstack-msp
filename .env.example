# ─── Omni TotalStack MSP — environment variables ─────────────────────────────
# Copy to .env.local for local dev. In production set these in Vercel → Settings → Environment Variables.
# Nothing here is required to try the app: without them it runs on demo data.

# Frontend (safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Server — core
PUBLIC_URL=https://your-omni-domain.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTEGRATIONS_ENCRYPTION_KEY=          # any long random string; encrypts API keys saved from the Integrations page
CRON_SECRET=                          # Vercel sends this to /api/cron/* automatically
AGENT_TOKEN=                          # shared secret for the Omni discovery agent
BUSINESS_TZ=America/New_York
LEAD_NOTIFY_EMAIL=                    # where new-lead alerts go
ALLOW_UNAUTHENTICATED_API=false       # true ONLY for local testing without Supabase auth

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# RMM (ninjaone | atera)
RMM_VENDOR=ninjaone
RMM_BASE_URL=https://app.ninjarmm.com
RMM_CLIENT_ID=
RMM_CLIENT_SECRET=

# Huntress
HUNTRESS_API_KEY=
HUNTRESS_API_SECRET=

# Microsoft 365 / Entra ID (Graph app registration)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# UniFi Site Manager
UNIFI_API_KEY=

# Inventory / distributor
INVENTORY_PROVIDER=pax8
INVENTORY_API_KEY=

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://your-omni-domain.com/api/quickbooks/callback
QBO_ENV=production

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payroll (Gusto)
PAYROLL_PROVIDER=gusto
PAYROLL_TOKEN=
GUSTO_COMPANY_ID=

# AI voice calls (vapi | retell | elevenlabs)
VOICE_PROVIDER=vapi
VOICE_API_KEY=
VOICE_ASSISTANT_ID=
VOICE_PHONE_NUMBER_ID=
VOICE_FROM_NUMBER=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Omni TotalStack MSP <updates@yourdomain.com>"
