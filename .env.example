# ─── Omni TotalStack MSP — environment variables ─────────────────────────────
# Set these in Vercel → Settings → Environment Variables (copy to .env.local for local dev).
# Without them the app runs as a single-browser demo.

# ── Front end (safe to expose) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PLATFORM_DOMAIN=omnitotalstack.com     # MSPs get <slug>.omnitotalstack.com
VITE_PLATFORM_HOSTS=                        # extra hostnames that should show the Omni sales site (comma-separated)

# ── Platform core (server) ──
PUBLIC_URL=https://omnitotalstack.com
PLATFORM_DOMAIN=omnitotalstack.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTEGRATIONS_ENCRYPTION_KEY=                # long random string; encrypts every MSP's API keys
CRON_SECRET=                                # Vercel sends this to /api/cron/*
PLATFORM_OWNER_EMAILS=crystallynncreates@gmail.com   # complimentary Enterprise account + Owner Console
BUSINESS_TZ=America/New_York

# ── Omni's own billing (MSPs paying YOU) — Stripe ──
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=             # webhook → https://<domain>/api/billing/webhook
STRIPE_PRICE_UNLIMITED=                     # price_… ($99/month, recurring)
STRIPE_PRICE_BUSINESS=                      # price_… ($249/month, recurring)
STRIPE_PRICE_ENTERPRISE=                    # price_… ($4,500 ONE-TIME — lifetime standalone copy)

# ── Standalone Enterprise copies only (see docs/STANDALONE.md) ──
# STANDALONE=true
# VITE_STANDALONE_SLUG=<the MSP's slug>

# ── Platform-provided services (shared by all MSPs) ──
ANTHROPIC_API_KEY=                          # Claude AI for Business/Enterprise workspaces
ANTHROPIC_MODEL=claude-sonnet-4-5
RESEND_API_KEY=                             # sends invites, weekly updates, invoices, notices
EMAIL_FROM_ADDRESS=updates@omnitotalstack.com   # verified sender; the display name is each MSP's brand

# ── Custom domains for MSPs (optional; adds domains to this Vercel project automatically) ──
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── QuickBooks app (one Intuit app for the platform; each MSP authorizes their own company) ──
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=                          # redirect URI: https://<domain>/api/quickbooks/callback
QBO_ENV=production

# Each MSP enters its OWN RMM, Huntress, Microsoft 365, UniFi, Stripe, payroll and voice keys in
# Integrations inside their workspace — they are encrypted per workspace and never shared.
